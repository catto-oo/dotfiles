{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
    	"source": "~/.config/hypr/fastfetch/hypr.png",
    	"type": "kitty",
      	"height": 20,
      	"padding": {
    		"top": 1,
            "left": 2
      	}
    },
    "display": {
          "separator": " ",
    },
    "modules": [
        "break",
        "break",
        "break",
        {
            "type": "title",
            "format": "{1}",
            "key": "╭─ ",
            "keyColor": "#b5d086"
        },
        {
            "type": "title",
            "format": "{2}",
            "key": "├─ ",
            "keyColor": "#b5d086"
        },
        {
            "type": "os",
            "format": "{2}",
            "key": "├─ ",
            "keyColor": "#b5d086"
        },
        {
            "type": "kernel",
            "format": "",
            "key": "├─ ",
            "keyColor": "#b5d086",
        },
        {
            "type": "packages",
            "format": "{2} (pacman), {14} (yay)",
            "key": "├─󰏖 ",
            "keyColor": "#b5d086",  
        },
        {
            "type": "disk",
            "format": "{15} days, {16} hours, {17} mins",
            "key": "├─ ",  
            "keyColor": "#b5d086"
        },
        {
            "type": "uptime",
            "format": "{10}",
            "key": "╰─󱑌 ",
            "keyColor": "#b5d086"
        },
        "break",




        {
            "type": "wm",
            "key": "╭─ ",
            "format": "{2}",
            "keyColor": "#c1caab", 
        },
        {
            "type": "terminal",
            "key": "├─ ",
            "keyColor": "#c1caab",
        },
        {
            "type": "shell",
            "key": "╰─ ",
            "keyColor": "#c1caab", 
        },

        "break",





        {
            "type": "host",
            "format": "{2}",
            "key": "╭─󰌢 ",
            "keyColor": "#a0d0c9",
        },
        {
            "type": "cpu",
            "format": "{1} ({7})",
            "key": "├─ ",
            "keyColor": "#a0d0c9",
        },
        {
            "type": "memory",
            "format": "",
            "key": "├─ ",
            "keyColor": "#a0d0c9",
        },

        {
            "type": "disk",
            "format": "{1} / {2} ({3})",
            "key": "├─ ",
            "keyColor": "#a0d0c9",
        },
        {
            "type": "monitor",
            "key": "╰─󰍹 ",
            "format": "14\" {2}x{3} @ 60Hz",
            "keyColor": "#a0d0c9",
        },
        "break",
        "break",
    ]
}

