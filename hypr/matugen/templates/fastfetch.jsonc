{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
    	"source": "~/.config/hypr/fastfetch/hypr.png",
    	"type": "kitty",
      	"height": 20,
      	"padding": {
    		"top": 1,
            "left": 2
      	}
    },
    "display": {
          "separator": " ",
    },
    "modules": [
        "break",
        "break",
        "break",
        {
            "type": "title",
            "format": "{1}",
            "key": "╭─ ",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "title",
            "format": "{2}",
            "key": "├─ ",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "os",
            "format": "{2}",
            "key": "├─ ",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "kernel",
            "format": "",
            "key": "├─ ",
            "keyColor": "{{colors.primary.default.hex}}",
        },
        {
            "type": "packages",
            "format": "{2} (pacman), {14} (yay)",
            "key": "├─󰏖 ",
            "keyColor": "{{colors.primary.default.hex}}",  
        },
        {
            "type": "disk",
            "format": "{15} days, {16} hours, {17} mins",
            "key": "├─ ",  
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "uptime",
            "format": "{10}",
            "key": "╰─󱑌 ",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        "break",




        {
            "type": "wm",
            "key": "╭─ ",
            "format": "{2}",
            "keyColor": "{{colors.secondary_fixed_dim.default.hex}}", 
        },
        {
            "type": "terminal",
            "key": "├─ ",
            "keyColor": "{{colors.secondary_fixed_dim.default.hex}}",
        },
        {
            "type": "shell",
            "key": "╰─ ",
            "keyColor": "{{colors.secondary_fixed_dim.default.hex}}", 
        },

        "break",





        {
            "type": "host",
            "format": "{2}",
            "key": "╭─󰌢 ",
            "keyColor": "{{colors.tertiary.default.hex}}",
        },
        {
            "type": "cpu",
            "format": "{1} ({7})",
            "key": "├─ ",
            "keyColor": "{{colors.tertiary.default.hex}}",
        },
        {
            "type": "memory",
            "format": "",
            "key": "├─ ",
            "keyColor": "{{colors.tertiary.default.hex}}",
        },

        {
            "type": "disk",
            "format": "{1} / {2} ({3})",
            "key": "├─ ",
            "keyColor": "{{colors.tertiary.default.hex}}",
        },
        {
            "type": "monitor",
            "key": "╰─󰍹 ",
            "format": "14\" {2}x{3} @ 60Hz",
            "keyColor": "{{colors.tertiary.default.hex}}",
        },
        "break",
        "break",
    ]
}

